# Copy this file to /etc/plotter-signature/plotter-signature.env and edit values.
#
# Required inbound API authentication for Flask (/api/*) and FastAPI (/printer/*):
PLOTTER_API_KEY=QSCWDVEFBRGNTHM
#
# Required for capture request flow:
CAPTURE_RESET_URL=http://127.0.0.1:9000/reset
#
# Optional capture settings:
CAPTURE_RESET_TOKEN=
CAPTURE_RESET_TIMEOUT_SECONDS=8.0
CAPTURE_RESET_METHOD=POST
#
# Optional scanner service settings (if scanner integration is enabled):
SCANNER_SERVICE_BASE_URL=http://127.0.0.1:8008
SCANNER_SERVICE_TIMEOUT_SECONDS=8.0
# Must match SCANNER_SERVICE_TOKEN from the scanner service (/etc/default/a4-scanner).
SCANNER_SERVICE_TOKEN=
# Legacy alias (used if SCANNER_SERVICE_TOKEN is empty):
# SCANNER_SERVICE_BEARER_TOKEN=
#
# Optional: automatic serial open when Flask/FastAPI start (default enabled). Set 0/false/no/off to skip (dev/CI).
# AUTO_CONNECT_ON_STARTUP=0
