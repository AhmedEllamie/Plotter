# Pen kiosk (user systemd — run after graphical login; do NOT use SupplementaryGroups here)
# Install root: /opt/Automated_Signature/plotter-signature (or run configure-units.sh)
[Unit]
Description=Plotter Pen Config Kiosk (User)
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/Automated_Signature/plotter-signature
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
Environment=PLOTTER_API_KEY_FILE=/etc/plotter-signature/plotter-signature.env
ExecStart=/opt/Automated_Signature/plotter-signature/.venv/bin/python -m plotter_signature.desktop.pen_kiosk
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=default.target
